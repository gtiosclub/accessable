rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isValidCoordinate(c) {
      return c is map
        && c.keys().toSet() == ['latitude', 'longitude'].toSet()
        && c.latitude is number && c.latitude >= -90 && c.latitude <= 90
        && c.longitude is number && c.longitude >= -180 && c.longitude <= 180;
    }

    function reportLifetime(kind) {
      return kind == 'construction' ? duration.value(7, 'd')
        : kind == 'elevatorOut' ? duration.value(24, 'h')
        : duration.value(4, 'h');
    }

    function isValidPointAt(area, size, i) {
      return i >= size || isValidCoordinate(area[i]);
    }

    // The checks are written to stay within the rules' budget of 1000 expressions a request with ten points.
    function isValidArea(area) {
      let size = area.size();
      return size >= 3 && size <= 10
        && isValidPointAt(area, size, 0) && isValidPointAt(area, size, 1) && isValidPointAt(area, size, 2)
        && isValidPointAt(area, size, 3) && isValidPointAt(area, size, 4) && isValidPointAt(area, size, 5)
        && isValidPointAt(area, size, 6) && isValidPointAt(area, size, 7) && isValidPointAt(area, size, 8)
        && isValidPointAt(area, size, 9);
    }

    // A new report, sent in one batch with its reporter's stamp, which names it so one stamp can't cover a batch
    // of many reports. The vote counts are optional, so an app from before REPORT-6 can still report.
    function isValidNewReport(data, reportId) {
      let keys = data.keys();
      let stamp = getAfter(rateLimitPath()).data;
      return keys.hasAll(['id', 'kind', 'coordinate', 'createdAt', 'expiresAt', 'confirmations', 'reporterID'])
        && keys.hasOnly([
          'id', 'kind', 'coordinate', 'area', 'createdAt', 'expiresAt', 'confirmations', 'reporterID',
          'negativeConfirmations', 'negativesSinceConfirm'
        ])
        && data.id == reportId
        && data.reporterID == request.auth.uid
        && data.kind in ['construction', 'blockedPath', 'closedEntrance', 'elevatorOut', 'other']
        && isValidCoordinate(data.coordinate)
        && (!('area' in keys) || data.area == null || (data.area is list && isValidArea(data.area)))
        && data.createdAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + reportLifetime(data.kind) + clockTolerance()
        && data.confirmations == 0
        && data.get('negativeConfirmations', 0) == 0
        && data.get('negativesSinceConfirm', 0) == 0
        && stamp.lastReportAt == request.time
        && stamp.lastReportId == reportId;
    }

    // REPORT-6: a phone's clock may be this far off the server's when it sets an expiry.
    function clockTolerance() {
      return duration.value(2, 'm');
    }

    function votePath(reportId) {
      return /databases/$(database)/documents/reports/$(reportId)/votes/$(request.auth.uid);
    }

    // A vote on someone else's live report, written in one batch with the voter's private vote
    // document and their vote stamp. "Yes" counts a confirmation and moves the expiry to one
    // lifetime from now, never earlier; "no" counts a denial and, the second one since the last
    // "yes", ends the report now, so every expiry filter drops it.
    function isValidVote(reportId) {
      let before = resource.data;
      let after = request.resource.data;
      let isStillPresent = getAfter(votePath(reportId)).data.isStillPresent;
      let lifetime = reportLifetime(before.kind);
      let denials = before.get('negativesSinceConfirm', 0) + 1;
      let stamp = getAfter(rateLimitPath()).data;

      return request.auth.uid != before.reporterID
        && before.expiresAt > request.time
        && !exists(votePath(reportId))
        && existsAfter(votePath(reportId))
        // the stamp names this report, so one stamp can't cover votes on many reports
        && stamp.lastVoteAt == request.time
        && stamp.lastVoteReportId == reportId
        && (isStillPresent
          ? after.diff(before).affectedKeys().hasOnly(['confirmations', 'negativesSinceConfirm', 'expiresAt'])
            && after.confirmations == before.confirmations + 1
            && after.get('negativesSinceConfirm', 0) == 0
            && after.expiresAt >= before.expiresAt
            && after.expiresAt >= request.time + lifetime - clockTolerance()
            // one already further out than a lifetime from now stays as it is
            && (after.expiresAt == before.expiresAt
              || after.expiresAt <= request.time + lifetime + clockTolerance())
          : after.diff(before).affectedKeys().hasOnly(['negativeConfirmations', 'negativesSinceConfirm', 'expiresAt'])
            // a report this new hasn't been walked past yet
            && request.time >= before.createdAt + duration.value(10, 'm')
            && after.negativeConfirmations == before.get('negativeConfirmations', 0) + 1
            && after.negativesSinceConfirm == denials
            && (denials >= 2 ? after.expiresAt == request.time : after.expiresAt == before.expiresAt));
    }

    function rateLimitPath() {
      return /databases/$(database)/documents/rateLimits/$(request.auth.uid);
    }

    // VOLUNTEER-2: private account profiles. Directory/presence data belongs
    // in a separate collection; callers must not list other users' private profiles.
    function validLanguageAt(languages, i) {
      return i >= languages.size()
        || (languages[i] is string && languages[i].size() >= 1
            && languages[i].size() <= 40 && languages[i].matches('.*[^ ].*'));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['role', 'displayName', 'languages', 'createdAt'])
        && data.keys().hasOnly(['role', 'displayName', 'languages', 'createdAt'])
        && data.role in ['caller', 'volunteer']
        && data.displayName is string && data.displayName.size() >= 1
        && data.displayName.size() <= 80 && data.displayName.matches('.*[^ ].*')
        && data.createdAt is timestamp
        && data.languages is list && data.languages.size() >= 1 && data.languages.size() <= 10
        && validLanguageAt(data.languages, 0) && validLanguageAt(data.languages, 1)
        && validLanguageAt(data.languages, 2) && validLanguageAt(data.languages, 3)
        && validLanguageAt(data.languages, 4) && validLanguageAt(data.languages, 5)
        && validLanguageAt(data.languages, 6) && validLanguageAt(data.languages, 7)
        && validLanguageAt(data.languages, 8) && validLanguageAt(data.languages, 9);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == userId
        && isValidUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role', 'displayName', 'languages']);
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    
    function isValidVolunteer(data) {
        return data.keys().hasAll(['displayName', 'languages', 'bio', 'isOnline', 'inCall', 'lastSeen'])
            && data.keys().hasOnly(['displayName', 'languages', 'bio', 'isOnline', 'inCall',
                                'ringingCallId', 'ringingSince', 'lastSeen'])
            && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
            && data.languages is list && data.languages.size() >= 1 && data.languages.size() <= 10
            && validLanguageAt(data.languages, 0) && validLanguageAt(data.languages, 1)
            && validLanguageAt(data.languages, 2) && validLanguageAt(data.languages, 3)
            && validLanguageAt(data.languages, 4) && validLanguageAt(data.languages, 5)
            && validLanguageAt(data.languages, 6) && validLanguageAt(data.languages, 7)
            && validLanguageAt(data.languages, 8) && validLanguageAt(data.languages, 9)
            && data.bio is string && data.bio.size() <= 300
            && data.isOnline is bool
            && data.inCall is bool
            && (!('ringingCallId' in data) || data.ringingCallId == null
                || (data.ringingCallId is string && data.ringingCallId.size() <= 128))
            && (!('ringingSince' in data) || data.ringingSince == null || data.ringingSince is timestamp)
            && data.lastSeen is timestamp;
    }

    match /volunteers/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 100;
      allow create: if signedIn() && request.auth.uid == uid
        && isValidVolunteer(request.resource.data)
        && request.resource.data.lastSeen == request.time
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'volunteer';
            allow update: if signedIn() && isValidVolunteer(request.resource.data)
        && (isOwnUpdate() || isRing() || isCallerClear());

      function isOwnUpdate() {
        return request.auth.uid == uid
          && request.resource.data.lastSeen == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
              || request.time >= resource.data.lastSeen + duration.value(20, 's'));
      }

      function isRing() {
        return request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ringingCallId', 'ringingSince'])
          && request.resource.data.ringingCallId is string
          && request.resource.data.ringingSince == request.time
          // Free: nobody is ringing them, or that ring is more than 45 seconds old.
          && (resource.data.get('ringingCallId', null) == null
              || request.time > resource.data.get('ringingSince', timestamp.value(0)) + duration.value(45, 's'))
          // Reachable: Online, not in a call, heard from in the last 90 seconds.
          && resource.data.isOnline == true
          && resource.data.inCall == false
          && request.time < resource.data.lastSeen + duration.value(90, 's')
          && isNewRingFromMe(request.resource.data.ringingCallId);
      }

      function isNewRingFromMe(callId) {
        let call = getAfter(/databases/$(database)/documents/calls/$(callId)).data;
        return call.callerId == request.auth.uid && call.volunteerId == uid && call.status == 'ringing';
      }

      function isCallerClear() {
        return request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ringingCallId', 'ringingSince'])
          && resource.data.get('ringingCallId', null) is string
          && request.resource.data.get('ringingCallId', null) == null
          && request.resource.data.get('ringingSince', null) == null
          && isFinishedRingFromMe(resource.data.ringingCallId);
      }

      function isFinishedRingFromMe(callId) {
        let call = getAfter(/databases/$(database)/documents/calls/$(callId)).data;
        return call.callerId == request.auth.uid && call.status in ['skipped', 'ended'];
      }

      allow delete: if signedIn() && request.auth.uid == uid;
    }
    
    match /calls/{callId} {
      function isParty() {
        return request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.volunteerId;
      }

      function moves(from, to) {
        return resource.data.status == from && request.resource.data.status == to;
      }

      // The call was still ringing this volunteer, and the same write marks them in the call.
      function isAccept() {
        let path = /databases/$(database)/documents/volunteers/$(resource.data.volunteerId);
        let before = get(path).data;
        let after = getAfter(path).data;
        return before.get('ringingCallId', null) == callId
          && after.inCall == true
          && after.get('ringingCallId', null) == null;
      }

      // Only project this caller's own first name. Do not open users/{uid} to volunteers.
      // Optional for compatibility with older clients/call documents; immutable after create.
      function validCallerFirstName() {
        let name = request.resource.data.get('callerFirstName', null);
        return !('callerFirstName' in request.resource.data) || (name is string && name.size() > 0 && name.size() <= 80
          && name == get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.displayName.replace('^\\s+', '').split('\\s+')[0]);
      }

      allow get: if signedIn() && isParty();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['callerId', 'volunteerId', 'status', 'roomName', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['callerId', 'volunteerId', 'status', 'roomName', 'createdAt', 'updatedAt', 'callerFirstName'])
        && validCallerFirstName()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.volunteerId is string
        && request.resource.data.volunteerId != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.roomName == 'call-' + callId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // The same write must ring the volunteer; the volunteers rules check they were free.
        && getAfter(/databases/$(database)/documents/volunteers/$(request.resource.data.volunteerId))
             .data.get('ringingCallId', null) == callId;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          // Caller: skip or give up while ringing; hang up once accepted.
          (request.auth.uid == resource.data.callerId
            && (moves('ringing', 'skipped') || moves('ringing', 'ended') || moves('accepted', 'ended')))
          // Volunteer: accept or decline while ringing; hang up once accepted.
          || (request.auth.uid == resource.data.volunteerId
            && ((moves('ringing', 'accepted') && isAccept())
                || moves('ringing', 'declined')
                || moves('accepted', 'ended')))
        );
      // No delete, so a finished call can never be reused.
    }

    match /reports/{reportId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 200;

      allow create: if signedIn() && isValidNewReport(request.resource.data, reportId);

      // Votes are the only edits: the reporter could otherwise extend, move or revive a report others voted on.
      allow update: if signedIn() && isValidVote(reportId);

      allow delete: if signedIn() && resource.data.reporterID == request.auth.uid;

      // One vote per user per report, readable only by its voter. Written only with the report's
      // matching count, which the report's update rule checks the other way round.
      match /votes/{voterId} {
        function reportPath() {
          return /databases/$(database)/documents/reports/$(reportId);
        }

        allow get: if signedIn() && request.auth.uid == voterId;
        allow create: if signedIn() && request.auth.uid == voterId
          && request.resource.data.keys().hasAll(['isStillPresent', 'votedAt'])
          && request.resource.data.keys().hasOnly(['isStillPresent', 'votedAt'])
          && request.resource.data.isStillPresent is bool
          && request.resource.data.votedAt == request.time
          && (request.resource.data.isStillPresent
            ? getAfter(reportPath()).data.confirmations == get(reportPath()).data.confirmations + 1
            : getAfter(reportPath()).data.get('negativeConfirmations', 0)
              == get(reportPath()).data.get('negativeConfirmations', 0) + 1);
      }
    }

    match /rateLimits/{userId} {
      // Each stamp names the report it was written with.
      function isReportStamp(keys) {
        return keys.hasOnly(['lastReportAt', 'lastReportId'])
          && request.resource.data.lastReportAt == request.time
          && request.resource.data.lastReportId is string;
      }

      function isVoteStamp(keys) {
        return keys.hasOnly(['lastVoteAt', 'lastVoteReportId'])
          && request.resource.data.lastVoteAt == request.time
          && request.resource.data.lastVoteReportId is string;
      }

      function hasKnownKeys() {
        return request.resource.data.keys().hasOnly(['lastReportAt', 'lastReportId', 'lastVoteAt', 'lastVoteReportId']);
      }

      function isSpaced(field) {
        return !(field in resource.data) || request.time >= resource.data[field] + duration.value(60, 's');
      }

      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && hasKnownKeys()
        && ((request.resource.data.keys().hasAll(['lastReportAt', 'lastReportId'])
              && isReportStamp(request.resource.data.keys()))
          || (request.resource.data.keys().hasAll(['lastVoteAt', 'lastVoteReportId'])
              && isVoteStamp(request.resource.data.keys())));
      allow update: if signedIn() && request.auth.uid == userId && hasKnownKeys()
        && ((isReportStamp(request.resource.data.diff(resource.data).affectedKeys())
              && request.resource.data.keys().hasAll(['lastReportAt', 'lastReportId'])
              && isSpaced('lastReportAt'))
          || (isVoteStamp(request.resource.data.diff(resource.data).affectedKeys())
              && isSpaced('lastVoteAt')));
    }
  }
}
