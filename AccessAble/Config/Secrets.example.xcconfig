// Copy this file to Secrets.xcconfig (same folder). Secrets.xcconfig is ignored by git.
//
// LiveKit server URL only. NEVER put the LiveKit API key or secret here:
// the secret lives only in the Cloudflare Worker (wrangler secret put LIVEKIT_API_SECRET).
//
// xcconfig treats "//" as a comment, so the URL is written wss:/$()/ ... which expands to wss://
LIVEKIT_URL = wss:/$()/YOUR-PROJECT.livekit.cloud
