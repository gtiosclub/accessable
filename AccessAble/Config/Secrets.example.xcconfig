// Copy this file to Secrets.xcconfig (same folder). Secrets.xcconfig is ignored by git.
//
// LiveKit server URL only. NEVER put the LiveKit API key or secret here:
// the secret lives only in the Cloudflare Worker (wrangler secret put LIVEKIT_API_SECRET).
//
// xcconfig treats "//" as a comment, so the URL is written wss:/$()/ ... which expands to wss://
LIVEKIT_URL = wss:/$()/accessable-u3ls0h5x.livekit.cloud

// Debug media test only: Settings > Project > Development token server in LiveKit Cloud.
// This is the token server ID, NOT the API key or secret. MATCH-1 replaces this flow.
LIVEKIT_DEV_TOKEN_SERVER_ID = accessable-1tvfw3

// VOLUNTEER-6: the getCallToken Worker (Workers/getCallToken). Not a secret; `npx wrangler deploy`
// prints the URL. Same "//" trick as LIVEKIT_URL above.
CALL_TOKEN_URL = https:/$()/getcalltoken.YOUR-SUBDOMAIN.workers.dev

// Valhalla servers for walking routes, asked in this order; Apple Maps is always asked last.
// Known names: stadia (needs STADIA_API_KEY below), fossgis (free public demo server, fair use only).
// Each server waits up to 6 s, all of them together up to 8 s, and after a timeout or a refused key a server is
// skipped for 2 minutes.
// Unknown names are ignored; naming none known gives the default, stadia,fossgis (set in Shared.xcconfig).
// ROUTING_SERVERS = fossgis

// Stadia Maps API key for walking routes. Ask the maps lead for it privately; never commit it.
// Left empty, Debug builds skip Stadia and route through the next server in ROUTING_SERVERS; Release builds fail.
// Each route request costs Stadia credits (check Stadia's pricing page), and one trip can send ~27 requests or more.
// Overage is off, so running out of credits is expected to return errors (HTTP 429; 402 is handled too).
// The key ships inside the app binary: if it leaks, rotate it in the Stadia dashboard.
// Never add Secrets.xcconfig to GitHub, including through the web upload.
STADIA_API_KEY =
