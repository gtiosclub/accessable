// Copy this file to Secrets.xcconfig (same folder) and paste the Stadia Maps API key below.
// Secrets.xcconfig is in .gitignore: never commit it, and never drag it into a GitHub web upload,
// which ignores .gitignore.
//
// The key still ships inside the app, so anyone with the app could read it. If it leaks, rotate it at
// https://client.stadiamaps.com and update this file.

STADIA_API_KEY = paste-your-key-here
